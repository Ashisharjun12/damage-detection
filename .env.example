# Copy to .env and fill secrets before: docker compose up -d --build

# === Public URLs & ports (change on Linode / staging server) ===
PUBLIC_URL=http://localhost
WEB_PORT=80
DAMAGE_AI_PORT=3000
BACKEND_PORT=3002
CORS_ORIGIN=http://localhost

# === Shared secrets (must match across damage-ai + test-backend) ===
JWT_SECRET=change-me-shared-secret
WEBHOOK_SECRET=change-me-webhook-secret

# === Docker internal URLs (defaults work for full compose stack) ===
WEBHOOK_URL=http://test-backend:3002/webhook
DAMAGE_AI_URL=http://damage-ai:3000
REDIS_URL=redis://redis:6379
MONGO_URI=mongodb://mongo:27017/damage-detection

# Production queue: rediss://default:TOKEN@host:6379 (omit bundled redis service)
# Production WEBHOOK_URL=https://your-laravel-api.com/webhook/m02

# === test-web (empty = same-origin /api via nginx) ===
VITE_API_URL=

# === damage-ai ===
PORT=3000
NODE_ENV=production
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=2048
MAX_CONCURRENT_GEMINI=2
MAX_IMAGES_PER_REQUEST=32
IMAGE_MAX_EDGE=2048
GEMINI_IMAGE_MAX_EDGE=1536
CONFIDENCE_REVIEW_THRESHOLD=0.7
CONFIDENCE_VERIFY_MIN=0.7
CONFIDENCE_ACCEPT_MIN=0.9
BBOX_MERGE_IOU_THRESHOLD=0.6
LOG_LEVEL=info

# Segmentation (MobileSAM + grounded Gemini) — set true only when mask overlays needed
SEG_ENABLED=false
SEG_PROVIDER=mobile-sam
SEG_ENCODER_PATH=./models/mobile_sam_encoder.onnx
SEG_DECODER_PATH=./models/mobile_sam_decoder.onnx
MAX_REGIONS_PER_IMAGE=4
SEG_MIN_MASK_IOU=0.5
SEG_MIN_MASK_AREA=0.001
GEMINI_REGION_MAX_EDGE=768
SEG_CAR_CROP_ENABLED=true

GEMINI_INR_PER_USD=94
GEMINI_USD_PER_M_INPUT=0.30
GEMINI_USD_PER_M_OUTPUT=2.50

# === test-backend ===
# BACKEND_PORT=3002 (host mapping in compose)

# === Cloudflare R2 (required for uploads + annotated images) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
