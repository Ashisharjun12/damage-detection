PORT=3000
NODE_ENV=development

JWT_SECRET=change-me-shared-with-test-backend
WEBHOOK_SECRET=change-me-shared-with-test-backend
WEBHOOK_URL=http://localhost:3002/webhook

REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=2048
MAX_CONCURRENT_GEMINI=2
MAX_IMAGES_PER_REQUEST=32

IMAGE_MAX_EDGE=2048
GEMINI_IMAGE_MAX_EDGE=1536

CONFIDENCE_REVIEW_THRESHOLD=0.7
CONFIDENCE_VERIFY_MIN=0.7
CONFIDENCE_ACCEPT_MIN=0.9
BBOX_MERGE_IOU_THRESHOLD=0.6
BBOX_MIN_VEHICLE_INSIDE_RATIO=0.75
BBOX_VEHICLE_TRIM_BOTTOM=0.08

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

LOG_LEVEL=info

GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=1000
IMAGE_GATE_ENABLED=true
GEMINI_GATE_MAX_EDGE=768

GEMINI_INR_PER_USD=94
GEMINI_USD_PER_M_INPUT=0.30
GEMINI_USD_PER_M_OUTPUT=2.50